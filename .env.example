# Copy to .env and fill in.

# Hugging Face token with accepted gates for HackAPrompt, WildJailbreak, WildGuardMix.
HF_TOKEN=
# OpenRouter API key (matched-pair generation, model-assisted labeling).
OPENROUTER_API_KEY=
# Container SAS URL for the Azure data source of truth (see data/README.md).
# Full URL incl. token: https://vulsightdata.blob.core.windows.net/morgott?<sas>
# Without it, scripts/azsync.sh falls back to your local `az login`.
MORGOTT_SAS_URL=""