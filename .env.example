# Copy to .env and fill in.

# Hugging Face token with accepted gates for HackAPrompt, WildJailbreak, WildGuardMix.
HF_TOKEN=
# OpenRouter API key (matched-pair generation, model-assisted labeling).
OPENROUTER_API_KEY=
# Container SAS URL for the Azure data source of truth (see data/README.md).
# Full URL incl. token: https://vulsightdata.blob.core.windows.net/morgott?<sas>
# Without it, scripts/azsync.sh falls back to your local `az login`.
MORGOTT_SAS_URL=""

# The variables below configure the Azure preview app (src/morgott/azure_app.py).
# Set them locally only to run the app outside Azure.
# Shared bearer key for /v1/status and /v1/assess; at least 32 characters.
# The Azure deployment injects this one from Key Vault (infra/main.bicep).
# MORGOTT_API_KEY=
# The two below are NOT set by the deployment; the deployed app runs on these
# defaults, so exporting them only affects local runs.
# Requested OpenVINO precision: auto, bf16, or fp32 (default auto).
# MORGOTT_INFERENCE_PRECISION=auto
# Registry path override (default model-artifacts.json).
# MORGOTT_MODEL_MANIFEST=model-artifacts.json